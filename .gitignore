.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.locks/

# Real credentials live here; only the *.example files are tracked.
config/*.env
config/.*.renewed.json
config/.*.tmp
config/.*.token.lock

# The lab rig moved to yoki-commvault-lab; these stay ignored until the
# copies left on disk here (media is several GB) are deleted by hand.
lab/.state/
lab/media/

# Database dumps hold real job data: never commit them. Better kept
# outside the checkout altogether (git clean -x would delete them).
backup/
backups/
*.dump
*.sql.gz
