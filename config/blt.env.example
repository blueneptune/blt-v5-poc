# Shared settings: read by deploy/up.sh (to start the pod) and by every
# collection run (to reach the API). Copy to config/blt.env.

# Key the collector sends in X-API-Key; the API rejects anything else.
BLT_API_KEY=change-me

# Where the collector reaches the API.
BLT_API_URL=http://127.0.0.1:8088

# Host ports the pod publishes, and the address they are published on.
# 127.0.0.1 means only this machine can connect. Set BLT_BIND_ADDRESS to
# 0.0.0.0 only if something on another machine has to reach the API or
# the database - then the API key and the Postgres password are all that
# protect them, over unencrypted connections. Changing any of these needs
# ./deploy/down.sh then ./deploy/up.sh (data is kept).
BLT_API_PORT=8088
BLT_PG_PORT=5433
# BLT_BIND_ADDRESS=127.0.0.1

# How the pod is put on the network. Leave unset normally: podman then
# forwards the two ports above to the containers.
#
# Set to "host" if that forwarding does not work - under WSL, rootless
# podman's forwarder (pasta) has answered "No route to host" or with an
# empty reply even though the API was running. In host mode nothing is
# forwarded: the API and Postgres listen on the ports above themselves,
# on BLT_BIND_ADDRESS, so every address stays the same.
#
# Changing it needs ./deploy/down.sh then ./deploy/up.sh (data is kept).
# BLT_POD_NETWORK=host

# --- Prefect (docs/prefect.md) -------------------------------------------
# true: deploy/up.sh and deploy/kube/up.sh also start the Prefect server
# and one worker in the pod. Off by default.
# BLT_PREFECT=true
#
# Password for the `prefect` Postgres user, which owns the `prefect`
# database the server creates on blt's Postgres the first time it starts.
# PREFECT_DB_PASSWORD=change-me
#
# user:password for Prefect's API (it serves no UI: blt's Administration
# pages replace it). Prefect's open-source server has no user accounts;
# this one shared login is all that guards it - and the credentials kept
# in its blocks. The worker and blt's API use it.
# PREFECT_AUTH=admin:change-me
#
# Prefect's port, and the address it is published on (default 127.0.0.1:
# only this machine's blt-prefect-* tools need it).
# How many CommCells may collect at the same time (every CommCell gets its
# own flow run; this caps how many do work at once). Default 4.
# BLT_MAX_PARALLEL=4
#
# BLT_PREFECT_PORT=4200
# BLT_PREFECT_BIND_ADDRESS=127.0.0.1

# --- The web UI (ui/) ----------------------------------------------------
# On unless BLT_UI=false. One account signs in: BLT_UI_USER (default
# admin) with the password whose hash is BLT_UI_PASSWORD_HASH. Make the
# hash and the session secret with:  cd ui && npm run password -- --secret
# (only the hash is kept; a new secret signs everyone out).
# It listens on this machine only (127.0.0.1) unless BLT_UI_BIND_ADDRESS
# says otherwise - it does not follow BLT_BIND_ADDRESS. Use https in front
# of it before opening it wider: the password crosses the network.
# Under WSL, open it from Windows at http://localhost:<port>.
# BLT_UI=true
# BLT_UI_USER=admin
# BLT_UI_PASSWORD_HASH=scrypt:32768:8:1:...
# BLT_UI_SESSION_SECRET=...
# BLT_UI_SIGN_IN=off   (only for a UI no other machine can reach)
# BLT_UI_PORT=8090
# BLT_UI_BIND_ADDRESS=127.0.0.1

# --- Nightly backups (deploy/backup.sh; install-timer runs it every night)
# Where the dumps go, how many nightly dumps of each database to keep, and
# when the timer runs (systemd OnCalendar time).
# BLT_BACKUP_DIR=~/blt-backups
# BLT_BACKUP_KEEP=14
# BLT_BACKUP_AT=02:30
