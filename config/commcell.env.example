# One file per CommCell: copy to config/<name>.env and run
#   ./collect.sh <name>
# <name> is also the key the jobs are stored under, so keep it stable.

# REST base URL, no trailing slash. Usually one of:
#   https://<webconsole-host>/commandcenter/api
#   https://<webconsole-host>/webconsole/api
#   http://<webserver-host>:81/SearchSvc/CVWebService.svc
CV_BASE_URL=https://commserve.example.com/commandcenter/api

# For Commvault Cloud (SaaS, formerly Metallic) instead - see
# docs/saas-setup.md:
#   CV_BASE_URL=https://api.metallic.io
#   CV_DEPLOYMENT=saas
# That switches the token header and applies an hourly call budget
# (SaaS tenants are rate-limited); CV_MAX_CALLS_PER_HOUR changes it.
# CV_DEPLOYMENT=software
# CV_MAX_CALLS_PER_HOUR=

# For an MSP (partner) account on Commvault Cloud - see docs/saas-setup.md.
# A file per customer tenant, each borrowing one credentials file and
# naming its tenant:
#   CV_CREDENTIALS=msp        # take URL and tokens from config/msp.env
#   CV_ACCOUNT_ID=1001        # sent as the lhAccountId header
#   CV_TENANT_GUID=...        # or this instead, sent as tenantGuid
#   CV_RING_ID=M301           # only for a customer on several rings

# Credentials: either an access token (Command Center > your user >
# Access tokens), or a username and password. The token wins if both are set.
CV_ACCESS_TOKEN=
# With the refresh token alongside it, the collector renews the access
# token itself when it expires and REWRITES the CV_ACCESS_TOKEN,
# CV_REFRESH_TOKEN and CV_TOKEN_* lines of this file. Don't hand-edit
# those while a collection is running.
CV_REFRESH_TOKEN=
# Maintained by the collector. RENEWABLE_UNTIL is the regeneration date:
# renewal stops working after it and a new token has to be created in
# Command Center. Runs start warning a week ahead.
CV_TOKEN_EXPIRES_AT=
CV_TOKEN_RENEWABLE_UNTIL=
CV_USERNAME=
CV_PASSWORD=

# TLS: point CV_CA_BUNDLE at a PEM file for a private CA, or set
# CV_VERIFY_TLS=false to skip verification entirely (needed for a
# self-signed certificate whose name doesn't match the host, e.g. the eval OVA).
CV_VERIFY_TLS=true
# CV_CA_BUNDLE=/etc/pki/tls/certs/commserve-ca.pem

# Optional tuning (defaults shown).
# CV_PAGE_SIZE=500
# First run: what is active plus this many hours of finished jobs.
# CV_INITIAL_LOOKBACK_HOURS=24
# How far back --full and --backfill will ever go.
# CV_HISTORY_LIMIT_DAYS=3650
# --backfill: slice width, slices per invocation, pause between slices.
# CV_BACKFILL_CHUNK_HOURS=24
# CV_BACKFILL_MAX_CHUNKS=30
# CV_BACKFILL_PAUSE_SECONDS=1
# CV_OVERLAP_MINUTES=60
# CV_TIMEOUT_SECONDS=120
