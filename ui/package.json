{
	"name": "blt-ui",
	"private": true,
	"version": "2026.11.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"api:types": "openapi-typescript ../docs/openapi.json -o src/lib/api/schema.d.ts",
		"api:check": "openapi-typescript ../docs/openapi.json -o .svelte-kit/schema.check.d.ts && cmp -s .svelte-kit/schema.check.d.ts src/lib/api/schema.d.ts || (echo 'src/lib/api/schema.d.ts is stale: run npm run api:types' && exit 1)"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"openapi-fetch": "^0.17.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.66.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.4.2",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.10.1",
		"mode-watcher": "^1.1.0",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.0.16",
		"vitest": "^4.0.0"
	}
}
