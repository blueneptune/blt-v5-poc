meta {
  name: Change one job's status
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/v1/sources/commvault/{{source_name}}/jobs/{{job_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "collected_at": "2026-10-29T14:01:30Z",
    "run_id": 1234,
    "status": "Not found in CommCell"
  }
}

docs {
  Used to mark a job the CommCell no longer knows as "Not found in
  CommCell"; anything Commvault can still describe goes through
  `POST .../jobs`.
}
