meta {
  name: Open a collection run
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/sources/commvault/{{source_name}}/runs
  body: json
  auth: inherit
}

body:json {
  {
    "lookup_seconds": 3900,
    "mode": "delta",
    "started_at": "2026-10-29T14:00:00Z"
  }
}

docs {
  Opens a run (status `running`) and returns it; send its `id`
  with each batch of jobs or objects. The CommCell is created on its
  first run.
}
