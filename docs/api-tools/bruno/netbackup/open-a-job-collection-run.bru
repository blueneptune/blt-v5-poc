meta {
  name: Open a job collection run
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/sources/netbackup/{{source_name}}/runs
  body: json
  auth: inherit
}

body:json {
  {
    "lookup_seconds": 2700,
    "mode": "delta",
    "started_at": "2026-11-08T14:02:00Z"
  }
}

docs {
  Opens a run (status `running`); send its `id` with each batch.
  The primary is created on its first run.
}
