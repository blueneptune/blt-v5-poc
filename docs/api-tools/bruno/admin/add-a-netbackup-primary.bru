meta {
  name: Add a NetBackup primary
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/admin/sources/netbackup
  body: json
  auth: inherit
}

body:json {
  {
    "api_key": "A1b2...",
    "name": "nbu-prod-01",
    "url": "nbu01.example.com"
  }
}

docs {
  Saves the primary's block. Collection starts off: check the
  primary first (`.../check`), then turn `collect` on.
}
