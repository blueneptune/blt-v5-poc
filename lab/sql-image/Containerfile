# A lab SQL Server host: Rocky 9 with Microsoft SQL Server 2022 (Developer
# edition - free, and licensed for non-production use only) and its
# command-line tools. As with lab/client-image there is no Commvault
# software in the image; the container installs the Commvault SQL Server
# agent from /media on first start and registers itself.
FROM docker.io/library/rockylinux:9

RUN curl -fsSL -o /etc/yum.repos.d/mssql-server.repo \
        https://packages.microsoft.com/config/rhel/9/mssql-server-2022.repo \
    && curl -fsSL -o /etc/yum.repos.d/mssql-prod.repo \
        https://packages.microsoft.com/config/rhel/9/prod.repo \
    && ACCEPT_EULA=Y dnf -y install mssql-server mssql-tools18 unixODBC \
        hostname procps-ng iproute iputils tar gzip bzip2 which findutils \
        chkconfig glibc-langpack-en libxcrypt-compat net-tools util-linux \
    && dnf clean all \
    && mkdir -p /data

ENV PATH="/opt/mssql-tools18/bin:${PATH}"
# See the comment in the systemctl file for why this exists.
COPY systemctl /usr/local/sbin/lab-systemctl
RUN mv /usr/bin/systemctl /usr/bin/systemctl.real \
    && install -m 0755 /usr/local/sbin/lab-systemctl /usr/bin/systemctl

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
